# Manifesto contract deployed on Celo Mainnet
VITE_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000
VITE_RPC_URL=https://forno.celo.org
VITE_CHAIN_ID=42220

# The Graph subgraph endpoint
VITE_SUBGRAPH_ENDPOINT=https://api.studio.thegraph.com/query/<team-id>/<subgraph>/v0.0.1

# Optional integrations
VITE_BLOCK_EXPLORER_URL=https://celoscan.io
VITE_ALCHEMY_API_KEY=

# Self configuration
VITE_SELF_SCOPE=manifesto-clean-streets
VITE_SELF_ENDPOINT_TYPE=celo
VITE_SELF_APP_NAME=Self Manifesto
VITE_SELF_LOGO_URL=https://i.postimg.cc/mrmVf9hm/self.png
VITE_SELF_MIN_AGE=16
VITE_SELF_EXCLUDED_COUNTRIES=
VITE_SELF_OFAC=false
VITE_SELF_DEEPLINK_CALLBACK=
VITE_SELF_USER_DATA=manifesto:clean-streets
VITE_SELF_REQUIRED_NATIONALITY=

# Debug logging (set to true to enable console.debug traces)
VITE_DEBUG_LOGS=false
